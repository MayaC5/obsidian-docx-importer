{
  "name": "obsidian-docx-importer",
  "version": "0.3.0",
  "description": "Import DOCX files into Obsidian vault as Markdown",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.20.5",
    "@types/turndown": "^5.0.4",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "jsdom": "^25.0.1",
    "obsidian": "latest",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "marked": "^18.0.4",
    "turndown": "^7.2.0"
  },
  "overrides": {
    "docx": {
      "nanoid": "5.1.16"
    },
    "mammoth": {
      "@xmldom/xmldom": "0.9.12"
    }
  }
}
